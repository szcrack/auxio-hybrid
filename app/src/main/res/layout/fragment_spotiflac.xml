<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Banner / Encabezado de Producciones Realverso -->
    <LinearLayout
        android:id="@+id/banner_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/img_logo_realverso"
            android:contentDescription="Producciones Realverso"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RVPLAYER"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Producciones Realverso • Lossless Hub"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_accounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuentas"
            android:textSize="12sp"
            app:icon="@drawable/ic_config_24"
            app:iconSize="16dp"
            style="@style/Widget.Material3.Button.TonalButton"/>
    </LinearLayout>

    <!-- Barra de selección de fuente de música -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spotify"
            style="@style/Widget.Material3.Chip.Filter"
            app:chipIcon="@drawable/ic_song_24"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/txt_provider_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="Catálogo oficial y playlists de Spotify"/>
    </LinearLayout>

    <!-- Barra de búsqueda con soporte para texto y URLs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:startIconDrawable="@drawable/ic_search_24"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Canción, artista o link de playlist..."
                android:imeOptions="actionSearch"
                android:inputType="textUri"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"
            style="@style/Widget.Material3.Button"/>
    </LinearLayout>

    <!-- Progreso de búsqueda -->
    <ProgressBar
        android:id="@+id/search_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        style="?android:attr/progressBarStyleLarge"/>

    <!-- Mensaje vacío / error con formato amigable -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>

    <!-- Lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_tracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"/>

</LinearLayout>
